<% if obj.errors.any? %>
  <div class="alert alert-danger alert-dismissible fade show border border-danger-subtle shadow-sm p-4" role="alert">
    <h5 class="fw-bold mb-3">
      <i class="bi bi-exclamation-triangle-fill me-2"></i>
      Errors while saving the <%= obj.class.name.downcase %>:
    </h5>
    <ul class="mb-0 ps-3">
      <% obj.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>