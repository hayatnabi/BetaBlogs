<div class="d-flex justify-content-center align-items-center vh-100">
  <div class="w-100" style="max-width: 1000px;">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card shadow-lg rounded-4">
            <div class="card-body p-4">
              <h3 class="card-title mb-4 text-center">
                Log Into Your Account
              </h3>
              <%= form_with scope: :session, url: login_path, local: true do |f| %>
                <div class="mb-3">
                  <%= f.label :email, class: "form-label" %>
                  <%= f.email_field :email, class: "form-control", placeholder: "Enter email" %>
                </div>
                <div class="mb-3 position-relative">
                  <%= f.label :password, class: "form-label" %>
                  <div class="input-group">
                    <%= f.password_field :password, class: "form-control", placeholder: "Enter password", id: "password" %>
                    <span class="input-group-text" onclick="togglePasswordVisibility('password', this)" style="cursor:pointer">
                      <i class="bi bi-eye"></i>
                    </span>
                  </div>
                </div>
                <div class="d-grid">
                  <%= f.submit "Login", class: "btn btn-primary btn-lg" %>
                </div>
              <% end %>
              <div class="text-center mt-3">
                <small>Don't have an account? <a href="/signup">Signup</a></small>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Password visibility toggle script -->
    <script>
      function togglePasswordVisibility(fieldId, iconSpan) {
        const input = document.getElementById(fieldId);
        const icon = iconSpan.querySelector('i');
        if (input.type === "password") {
          input.type = "text";
          icon.classList.remove("bi-eye");
          icon.classList.add("bi-eye-slash");
        } else {
          input.type = "password";
          icon.classList.remove("bi-eye-slash");
          icon.classList.add("bi-eye");
        }
      }
    </script>
  </div>
</div>
