<div class="container my-1.5">
  <table class="table table-striped table-hover table-bordered shadow-sm mt-2">
    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Description</th>
        <th colspan="3" class="text-center">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @articles.each do |article| %>
        <tr>
          <td class="text-center"><%= article.id %></td>
          <td class="text-start"><%= article.title %></td>
          <td class="text-start"><%= truncate(article.description, length: 50) %><br>
            Created <i><%= time_ago_in_words(article.created_at)%></i> ago, 
            Edited <i><%= time_ago_in_words(article.updated_at)%></i> ago by <%= link_to article.user.username, user_path(article.user) if article.user %>
          </td>
          <td class="text-center">
            <%= link_to 'View', article_path(article), class: "btn btn-sm btn-outline-primary" %>
          </td>
          <td class="text-center">
            <%= link_to 'Edit', edit_article_path(article), class: "btn btn-sm btn-outline-secondary" %>
          </td>
          <td class="text-center">
            <%= button_to 'Delete', article_path(article),
                method: :delete,
                data: { confirm: 'Are you sure you want to delete this article?' },
                class: "btn btn-sm btn-outline-danger w-auto px-3",
                form: { class: 'form-inline m-0 p-0' } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
