<div class="container my-5">
  <div class="card shadow-sm p-4">
    <h1 class="text-center mb-4">Article Details</h1>
    <p><strong>Author:</strong> <span class="text-muted"><%= @article.user.username if @article.user %></span></p>
    <p><strong>Title:</strong> <span class="text-muted"><%= @article.title %></span></p>
    <div><strong>Description:</strong> <span class="text-muted"><%= simple_format(@article.description) %></span></div>
    <div class="mt-4 d-flex align-items-center gap-2 flex-wrap">
      <% if logged_in? && (@article.user == current_user || current_user.admin? ) %>
        <%= link_to 'Edit', edit_article_path(@article), class: "btn btn-sm btn-outline-secondary" %>
        <button class="btn btn-sm btn-outline-danger w-auto px-3" onclick="confirmDeletion(event, '<%= article_path(@article) %>', 'Are you sure you want to delete?')">Delete</button>
        <%= render "shared/confirm_deletion_script" %>
      <% end %>
      <%= link_to 'Show All Articles', articles_path, class: "btn btn-sm btn-outline-primary" %>
    </div>
  </div>
</div>
