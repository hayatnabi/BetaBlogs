<!-- app/views/users/new.html.erb -->
<%= render "shared/errors", obj: @user %>
<div class="container">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card shadow-lg rounded-4">
        <div class="card-body p-4">
          <%# <h3 class="card-title mb-4 text-center">Create an Account</h3> %>
          <h3 class="card-title mb-4 text-center">
            <%= @user.new_record? ? "Create an Account" : "Update Your Account" %>
          </h3>
          <%= form_with model: @user, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :username, class: "form-label" %>
              <%= f.text_field :username, class: "form-control", placeholder: "johndoe007" %>
            </div>
            <div class="mb-3">
              <%= f.label :email, class: "form-label" %>
              <%= f.email_field :email, class: "form-control", placeholder: "you@example.com" %>
            </div>
            <div class="mb-3 position-relative">
              <%= f.label :password, class: "form-label" %>
              <div class="input-group">
                <%= f.password_field :password, class: "form-control", placeholder: "Create password", id: "password" %>
                <span class="input-group-text" onclick="togglePasswordVisibility('password', this)" style="cursor:pointer">
                  <i class="bi bi-eye"></i>
                </span>
              </div>
            </div>
            <div class="d-grid">
              <%= f.submit(@user.new_record? ? "Sign Up" : "Update Account", class: "btn btn-primary btn-lg") %>
            </div>
          <% end %>
          <% if @user.new_record? %>
            <div class="text-center mt-3">
              <small>Already have an account? <a href="#">Login</a></small>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Password visibility toggle script -->
<script>
  function togglePasswordVisibility(fieldId, iconSpan) {
    const input = document.getElementById(fieldId);
    const icon = iconSpan.querySelector('i');
    if (input.type === "password") {
      input.type = "text";
      icon.classList.remove("bi-eye");
      icon.classList.add("bi-eye-slash");
    } else {
      input.type = "password";
      icon.classList.remove("bi-eye-slash");
      icon.classList.add("bi-eye");
    }
  }
</script>
